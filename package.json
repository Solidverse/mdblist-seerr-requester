{
  "name": "mdblist-seerr-requester",
  "version": "1.0.0",
  "description": "A lightweight, self-hosted application that automatically discovers movies and TV shows from MDBList and submits requests to Seerr.",
  "main": "src/index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "node --test tests/config.test.js tests/config-watcher.test.js tests/database.test.js tests/mdblist.test.js tests/scheduler.test.js tests/seerr.test.js tests/request.test.js",
    "test:integration": "node --env-file=integration-test.env --test tests/mdblist.integration.test.js",
    "test:integration:seerr": "node --env-file=integration-test.env --test tests/seerr.integration.test.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "update:mdblist-openapi": "node scripts/update-mdblist-openapi.js",
    "update:seerr-openapi": "node scripts/update-seerr-openapi.js",
    "update:openapi": "npm run update:mdblist-openapi && npm run update:seerr-openapi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Solidverse/mdblist-seerr-requester.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Solidverse/mdblist-seerr-requester/issues"
  },
  "homepage": "https://github.com/Solidverse/mdblist-seerr-requester#readme",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "cron-parser": "^5.10.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
